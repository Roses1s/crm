# -----------------------------------------------------------------------------
#  Автозапуск стека CRM при загрузке сервера.
#  Путь на сервере: /etc/systemd/system/crm.service
#
#  Установка:
#    sudo cp crm.service /etc/systemd/system/crm.service
#    sudo systemctl daemon-reload
#    sudo systemctl enable --now crm.service
#
#  Зачем отдельный юнит, если у контейнеров есть restart: unless-stopped?
#  Политика перезапуска Docker не всегда срабатывает после перезагрузки хоста
#  (особенно при включённом live-restore или нештатном выключении). systemd
#  гарантированно выполнит `docker compose up -d` после старта docker.service.
# -----------------------------------------------------------------------------

[Unit]
Description=CRM Detroid stack (docker compose)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/crm
ExecStart=/usr/bin/docker compose up -d --remove-orphans
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
