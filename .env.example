# Скопировать в .env рядом с docker-compose.yml и заполнить.
# Файл .env в репозиторий не коммитится (см. .gitignore).

# --- окружение ---------------------------------------------------------------
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=true

# --- безопасность ------------------------------------------------------------
# Сгенерировать: openssl rand -hex 32
SECRET_KEY=ЗАМЕНИТЕ_МЕНЯ
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=14
CORS_ORIGINS=["https://crmdetroid.ru"]

# --- PostgreSQL --------------------------------------------------------------
# Сгенерировать: openssl rand -hex 24
POSTGRES_USER=crm
POSTGRES_PASSWORD=ЗАМЕНИТЕ_МЕНЯ
POSTGRES_DB=crm

# --- производительность ------------------------------------------------------
# На VPS с 2 ГБ памяти больше двух воркеров Gunicorn держать не стоит.
GUNICORN_WORKERS=2

# --- наблюдаемость (необязательно) -------------------------------------------
# SENTRY_DSN=https://...@...ingest.sentry.io/...
SENTRY_TRACES_SAMPLE_RATE=0.1
