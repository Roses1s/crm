# Скопировать в .env рядом с docker-compose.yml и заполнить.
# Файл .env в репозиторий не коммитится (см. .gitignore).

# --- окружение ---------------------------------------------------------------
ENVIRONMENT=production
LOG_LEVEL=INFO
LOG_JSON=true

# --- безопасность ------------------------------------------------------------
# Сгенерировать: openssl rand -hex 32
SECRET_KEY=ЗАМЕНИТЕ_МЕНЯ
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=14
CORS_ORIGINS=["https://crmdetroid.ru"]

# --- PostgreSQL --------------------------------------------------------------
# Сгенерировать: openssl rand -hex 24
POSTGRES_USER=crm
POSTGRES_PASSWORD=ЗАМЕНИТЕ_МЕНЯ
POSTGRES_DB=crm

# --- вложения и место на диске -----------------------------------------------
# Сколько мегабайт оставлять свободными: при меньшем запасе загрузка файлов
# отвечает отказом, чтобы переполнение диска не остановило PostgreSQL.
MIN_FREE_DISK_MB=1024
# Срок хранения журнала попыток входа (раздел «Безопасность»).
LOGIN_ATTEMPTS_KEEP_DAYS=90

# --- сеть между API и nginx --------------------------------------------------
# Отдельная сеть из двух контейнеров. Подсеть не должна пересекаться с сетью
# сервера/VPN; если меняете её, задайте IP nginx в этой подсети.
CRM_PROXY_SUBNET=172.31.250.0/24
CRM_NGINX_PROXY_IP=172.31.250.2

# --- производительность ------------------------------------------------------
# Число воркеров Gunicorn. На VPS с 4 ГБ памяти держим 3 (на 2 ГБ было 2).
GUNICORN_WORKERS=3

# --- наблюдаемость (необязательно) -------------------------------------------
# SENTRY_DSN=https://...@...ingest.sentry.io/...
SENTRY_TRACES_SAMPLE_RATE=0.1
