# Скопировать в backend/.env для локального запуска.
# На сервере значения задаются в docker-compose.yml (этап 4).

ENVIRONMENT=local
DEBUG=true
LOG_LEVEL=INFO
LOG_JSON=false

# Обязательно заменить в продакшене: openssl rand -hex 32
SECRET_KEY=dev-secret-change-me
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=14
CORS_ORIGINS=["http://localhost:5173","https://crmdetroid.ru"]

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=crm
POSTGRES_PASSWORD=crm
POSTGRES_DB=crm
# DATABASE_URL=postgresql+asyncpg://crm:crm@localhost:5432/crm

VALKEY_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=60

RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN=10/minute

# SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
